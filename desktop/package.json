{
  "name": "warden-ai-desk",
  "version": "0.2.2",
  "private": true,
  "license": "UNLICENSED",
  "description": "Chromium-backed local desktop workspace for Warden AI Desk",
  "desktopName": "warden-ai-desk",
  "homepage": "https://github.com/matthewjmcbridejr-code/Warden",
  "author": { "name": "Warden Project", "email": "noreply@localhost" },
  "main": "dist/main.cjs",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm run test && npm run build",
    "start": "npm run build && electron .",
    "dev": "npm run build && electron .",
    "package:linux": "npm run check && electron-builder --linux --dir",
    "package:deb": "npm run check && electron-builder --linux deb"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "electron": "^43.1.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "build": {
    "appId": "com.usemarius.warden.desk",
    "productName": "Warden AI Desk",
    "files": ["dist/**", "package.json"],
    "directories": { "output": "dist-electron" },
    "asarUnpack": ["node_modules/node-pty/**"],
    "linux": { "target": ["AppImage", "deb"], "category": "Development", "executableName": "warden-ai-desk", "icon": "assets/icon.png", "syncDesktopName": true }
  }
}
