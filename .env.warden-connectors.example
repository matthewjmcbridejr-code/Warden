# Warden Connectors — environment variables
# Copy to .env.warden-connectors and fill in real values (never commit secrets)

WARDEN_CONNECTORS_ENABLED=1
WARDEN_CONNECTOR_BASE_URL=http://127.0.0.1:6969

# Encryption key for token vault (optional — if empty, tokens stored in plaintext locally)
WARDEN_CONNECTOR_ENCRYPTION_KEY=

# Gmail OAuth2 (https://console.cloud.google.com/)
WARDEN_GOOGLE_OAUTH_CLIENT_ID=
WARDEN_GOOGLE_OAUTH_CLIENT_SECRET=

# Microsoft/Outlook OAuth2 (https://portal.azure.com/)
WARDEN_MICROSOFT_OAUTH_CLIENT_ID=
WARDEN_MICROSOFT_OAUTH_CLIENT_SECRET=

# Mail behavior
WARDEN_MAIL_ALLOW_SEND=0
WARDEN_CONNECTORS_REQUIRE_CONFIRMATION=1
