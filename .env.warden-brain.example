# Warden Brain — Local vault + Google Brain
# Copy relevant lines to ~/.config/warden/cloud_keys.env
# Do NOT commit actual values to git.

# --- Local Brain (free, default) ---
WARDEN_BRAIN_ENABLED=1
WARDEN_BRAIN_PROVIDER=local
WARDEN_BRAIN_VAULT_PATH=/home/you/warden-vault
WARDEN_BRAIN_INDEX_PATH=/home/you/.local/share/warden/brain/brain.sqlite3
WARDEN_BRAIN_ALLOW_NOTE_WRITE=1
WARDEN_BRAIN_WRITE_FOLDER=00-inbox

# --- Google Brain (optional upgrade) ---
# Requires: discoveryengine.googleapis.com enabled in your GCP project
# Auth: Application Default Credentials (gcloud auth application-default login)
# or a service account key (WARDEN_GOOGLE_APPLICATION_CREDENTIALS=/path/to/key.json)
WARDEN_GOOGLE_BRAIN_ENABLED=1
WARDEN_GOOGLE_PROJECT_ID=your-gcp-project-id
WARDEN_GOOGLE_LOCATION=global
WARDEN_GOOGLE_DISCOVERY_ENGINE_DATA_STORE_ID=your-data-store-id
# Engine ID — required when serving config is under engines/ path (most new setups)
WARDEN_GOOGLE_DISCOVERY_ENGINE_ENGINE_ID=your-search-engine-id
WARDEN_GOOGLE_DISCOVERY_ENGINE_SERVING_CONFIG=default_search
WARDEN_GOOGLE_BRAIN_COLLECTION_ID=default_collection
# Leave blank to use Application Default Credentials (ADC):
# WARDEN_GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# --- Gmail OAuth (for email connector) ---
# Enter these through Warden Settings UI, not here.
# Go to: http://127.0.0.1:6969/web/warden/app.html
#   → Settings → Account Connectors → Gmail → Set up Gmail connection
# WARDEN_GOOGLE_OAUTH_CLIENT_ID=<enter in Warden UI>
# WARDEN_GOOGLE_OAUTH_CLIENT_SECRET=<enter in Warden UI>
