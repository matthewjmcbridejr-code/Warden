{
  "manifest_version": 3,
  "name": "Warden Watcher",
  "version": "2.0.0",
  "description": "Save webpages, selections, YouTube transcripts, and PDFs into Warden Brain.",
  "permissions": [
    "tabs",
    "activeTab",
    "webNavigation",
    "storage",
    "scripting",
    "alarms",
    "clipboardRead"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Warden Watcher"
  }
}
