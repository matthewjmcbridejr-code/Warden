{
  "manifest_version": 3,
  "name": "Warden Memory Collector",
  "version": "1.0.0",
  "description": "Captures browsing activity, searches, and AI conversations into Warden memory.",
  "permissions": [
    "tabs",
    "activeTab",
    "webNavigation",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Warden Memory"
  }
}
