#!/usr/bin/env bash
# One-command Warden start: creates a venv on first run, installs the
# package, and serves the UI at the root URL.
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
PORT="${WARDEN_PORT:-4242}"
HOST="${WARDEN_HOST:-127.0.0.1}"

cd "$ROOT"
if [ ! -x ".venv/bin/python" ]; then
  echo "First run — creating a virtualenv and installing Warden…"
  python3 -m venv .venv
  .venv/bin/pip install -q -e .
fi

echo
echo "  Warden: http://${HOST}:${PORT}"
echo
exec .venv/bin/python -m uvicorn src.warden.app:app --host "$HOST" --port "$PORT" --log-level warning
