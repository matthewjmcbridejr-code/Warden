[Unit]
Description=Warden Brain MCP HTTP Server (local)
After=network.target
Wants=network.target

[Service]
Type=simple
User=warden
WorkingDirectory=/opt/warden
Environment=PYTHONPATH=/opt/warden:/opt/warden/src
Environment=MCHARNESS_DATA_ROOT=/var/lib/warden/_mctable
EnvironmentFile=-/etc/warden/brain.env
ExecStart=/opt/warden/.venv/bin/python -m warden.brain_mcp_server --http --host 127.0.0.1 --port 8126
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=warden-brain

[Install]
WantedBy=multi-user.target
