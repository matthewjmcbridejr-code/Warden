# Cloud Run runtime configuration. Store real values in Secret Manager or the
# Vercel/GCP environment settings; never commit a populated copy.
MCHARNESS_PUBLIC_WRITE_ENABLED=false
MCHARNESS_TMUX_RUNNER_ENABLED=false
MCHARNESS_CODEX_RUNNER_ENABLED=false
WARDEN_GOOGLE_BRAIN_ENABLED=1
WARDEN_GOOGLE_PROJECT_ID=booming-key-500220-d9
WARDEN_GOOGLE_LOCATION=global
WARDEN_GOOGLE_DISCOVERY_ENGINE_DATA_STORE_ID=replace-me
WARDEN_GOOGLE_DISCOVERY_ENGINE_SERVING_CONFIG=default_search
WARDEN_GOOGLE_BRAIN_COLLECTION_ID=default_collection
# Cloud-primary memory/state. Inject the real DSN from Secret Manager; this
# socket form is for Cloud Run with --add-cloudsql-instances.
WARDEN_BRAIN_BACKEND=postgres
WARDEN_BRAIN_DATABASE_URL=postgresql://warden_app:REPLACE_ME@/warden?host=/cloudsql/booming-key-500220-d9:us-central1:warden-brain
WARDEN_ARTIFACT_BACKEND=gcs
WARDEN_ARTIFACT_BUCKET=booming-key-500220-d9-warden-brain
# Vercel server-side bridge to the private Cloud Run service. These are
# identifiers only; Vercel OIDC supplies the short-lived subject token.
GCP_CLOUD_RUN_URL=https://warden-api-cpjzhcvbha-uc.a.run.app
GCP_WORKLOAD_IDENTITY_PROVIDER=projects/341941245324/locations/global/workloadIdentityPools/vercel/providers/vercel
GCP_SERVICE_ACCOUNT=warden-vercel-bridge@booming-key-500220-d9.iam.gserviceaccount.com
# Sign in with Vercel OAuth. Register the callback URL
# https://<vercel-domain>/api/auth/callback, then configure these only in
# Vercel encrypted environment variables. The allowlist is mandatory.
VERCEL_CLIENT_ID=REPLACE_WITH_VERCEL_APP_CLIENT_ID
VERCEL_CLIENT_SECRET=REPLACE_WITH_VERCEL_APP_CLIENT_SECRET
VERCEL_AUTH_REDIRECT_URI=https://<vercel-domain>/api/auth/callback
WARDEN_ALLOWED_VERCEL_EMAILS=operator@example.com
# Temporary break-glass gate; remove after OAuth is verified.
WARDEN_CONSOLE_TOKEN=REPLACE_WITH_RANDOM_SECRET
