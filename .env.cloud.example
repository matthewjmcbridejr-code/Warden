# Cloud Run runtime configuration. Store real values in Secret Manager or the
# Vercel/GCP environment settings; never commit a populated copy.
MCHARNESS_PUBLIC_WRITE_ENABLED=false
WARDEN_TMUX_RUNNER_ENABLED=false
WARDEN_CODEX_RUNNER_ENABLED=false
WARDEN_GOOGLE_BRAIN_ENABLED=1
WARDEN_GOOGLE_PROJECT_ID=booming-key-500220-d9
WARDEN_GOOGLE_LOCATION=global
WARDEN_GOOGLE_DISCOVERY_ENGINE_DATA_STORE_ID=replace-me
WARDEN_GOOGLE_DISCOVERY_ENGINE_SERVING_CONFIG=default_search
WARDEN_GOOGLE_BRAIN_COLLECTION_ID=default_collection
# Managed persistence is required before enabling writes in production.
WARDEN_STORAGE_BACKEND=cloud_sql
WARDEN_OBJECT_STORE_BUCKET=replace-me
