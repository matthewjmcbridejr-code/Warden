FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app

WORKDIR /app
COPY pyproject.toml README.md ./
COPY src ./src
COPY web ./web
COPY branding.json ./branding.json

RUN pip install --no-cache-dir . \
    && python -c "import playwright; print('playwright import: ok')"

EXPOSE 8080
CMD ["sh", "-c", "uvicorn src.server.api:app --host 0.0.0.0 --port ${PORT:-8080} --log-level info"]
